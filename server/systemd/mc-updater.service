# Minecraft mod updater — polls the repo, syncs the server's mods, and restarts
# the server once it's empty. Triggered by mc-updater.timer (not enabled directly).
#
# Install (adjust paths/user/branch first):
#   sudo cp server/systemd/mc-updater.service server/systemd/mc-updater.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mc-updater.timer

[Unit]
Description=Minecraft mod updater (poll repo, sync mods, restart when empty)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=maxmason
Environment=REPO_DIR=/home/maxmason/minecraft-repo
Environment=MINECRAFT_SERVER_DIR=/home/maxmason/minecraft-server
Environment=MINECRAFT_BRANCH=main
Environment=MINECRAFT_TMUX_SESSION=minecraft
Environment=MINECRAFT_SERVICE=minecraft
ExecStart=/home/maxmason/minecraft-repo/server/poll-updater.sh
