# GitHub webhook listener — receives push events (via Cloudflare Tunnel),
# syncs mods, and restarts the Minecraft server once it's empty.
#
# Install (adjust paths/user first, and create the secret file):
#   echo "your-webhook-secret" > /home/pi/.mc-webhook-secret && chmod 600 /home/pi/.mc-webhook-secret
#   sudo cp server/systemd/mc-updater.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mc-updater

[Unit]
Description=Minecraft mod updater (GitHub webhook listener)
After=network-online.target
Wants=network-online.target

[Service]
User=pi
Environment=REPO_DIR=/home/pi/minecraft-server
Environment=MINECRAFT_SERVER_DIR=/home/pi/minecraft-fabric
Environment=WEBHOOK_SECRET_FILE=/home/pi/.mc-webhook-secret
Environment=UPDATER_PORT=9000
ExecStart=/usr/bin/python3 /home/pi/minecraft-server/server/updater.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
